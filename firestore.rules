rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /groups/{groupId} {
      allow read, create, update, delete: if signedIn();

      match /members/{memberId} {
        allow read, create, update, delete: if signedIn();
      }

      match /messages/{messageId} {
        allow read, create, update, delete: if signedIn();
      }
    }
  }
}
