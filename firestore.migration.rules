rules_version = '2';

// 一時的な旧版互換用。最終ルールと同等のアクセス制限はありません。
// 新規プロジェクトや長期運用には使用しないでください。

// 更新版アプリへの移行期間だけ使用するルール。
// 旧版との互換性を残すため、更新版の普及後は必ずfirestore.rulesへ切り替える。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validCode(code) {
      return code is string && code.matches('^[0-9]{6}$');
    }

    match /groupCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && validCode(code)
        && request.resource.data.keys().hasOnly([
          'groupID', 'ownerAuthUID', 'createdAt'
        ])
        && request.resource.data.ownerAuthUID == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupID))
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupID)).data.code == code
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupID)).data.ownerAuthUID
          == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.ownerAuthUID == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read, create, update, delete: if signedIn();

      match /members/{memberId} {
        allow read, create, update, delete: if signedIn();
      }

      match /messages/{messageId} {
        allow read, create, update, delete: if signedIn();
      }
    }
  }
}
